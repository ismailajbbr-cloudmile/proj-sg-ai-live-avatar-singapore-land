# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by Docker Compose for the postgres service and DATABASE_URL construction.
# Backend (Pydantic) reads this file from the repo root — single source of truth.

POSTGRES_USER=avatar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=avatar_chatbot

# Local dev connection (Docker Compose overrides this with postgres:5432 hostname)
DATABASE_URL=postgresql+asyncpg://avatar:change-me@localhost:5432/avatar_chatbot

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── GCP / Vertex AI ───────────────────────────────────────────────────────────
GOOGLE_VERTEX_PROJECT=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1
VERTEX_AI_WEB_DATASTORE_ID=
VERTEX_AI_PDF_DATASTORE_ID=

# Set by Docker Compose — only override for local dev without Docker
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json

NEXT_PUBLIC_ORIGIN=http://localhost:3000

SESSION_IDLE_TIMEOUT_MINUTES=5

# ── TTS (Gemini) ──────────────────────────────────────────────────────────────
# TTS_MODEL=gemini-2.5-flash-tts
# TTS_VOICE_NAME=Achernar
# TTS_VOICE_PROMPT=Read aloud in a warm, welcoming tone with a Singaporean accent. Speak naturally and conversationally.
