# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Dev: used by docker-compose.dev.yml for the local postgres service.
POSTGRES_USER=avatar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=avatar_chatbot

# Dev connection (docker-compose.dev.yml overrides this with postgres:5432 hostname)
DATABASE_URL=postgresql+asyncpg://avatar:change-me@localhost:5432/avatar_chatbot

# Prod (Cloud SQL Auth Proxy): docker-compose.yml sets this directly — no .env entry needed.
# Format: note that special chars in passwords must be URL-encoded (e.g. @ → %40)
# DATABASE_URL=postgresql+asyncpg://app-user:your-password@cloud-sql-proxy:5432/avatar_chatbot

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── GCP / Vertex AI ───────────────────────────────────────────────────────────
GOOGLE_VERTEX_PROJECT=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1
VERTEX_AI_WEB_DATASTORE_ID=
VERTEX_AI_WEB_ENGINE_ID=
VERTEX_AI_PDF_DATASTORE_ID=
# true (default): answers must come from Vertex AI Search. Empty IDs return the directory fallback.
# false: general demo chat with no venue directory. Leave the datastore IDs blank.
# REQUIRE_DATASTORE_GROUNDING=false

# Chat model (Vertex AI). Use gemini-3.5-flash for 3.5; backend applies minimal thinking for 3.x.
# GEMINI_CHAT_MODEL=gemini-3.5-flash

# GCP key file: place avatar-chatbot-key.json at the repo root (gitignored via *-key.json).
# Docker Compose mounts it to /app/credentials/gcp-key.json and sets GOOGLE_APPLICATION_CREDENTIALS — no .env entry needed in containers.
# Local uv run / host tools: set an absolute path (relative paths break if cwd is not repo root), e.g.:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/avatar_chatbot/avatar-chatbot-key.json

NEXT_PUBLIC_ORIGIN=http://localhost:3000

SESSION_IDLE_TIMEOUT_MINUTES=5

# ── AI provider ───────────────────────────────────────────────────────────────
# google (default) keeps Vertex AI Gemini, Vertex AI Search, and Gemini TTS.
# alibaba uses Qwen for chat and CosyVoice for speech. The mall directory stays empty
# until ALIBABA_KNOWLEDGE_INDEX_ID is set, so factual answers use the same fallback.
# AI_PROVIDER=google
# DASHSCOPE_API_KEY=
# Workspace host, no path. Singapore example:
# DASHSCOPE_API_HOST=https://llm-your-workspace.ap-southeast-1.maas.aliyuncs.com
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_TTS_MODEL=qwen3-tts-flash
# DASHSCOPE_TTS_VOICE=Cherry
# Cloned voice id for Bahasa Indonesia. Preset Singapore voices do not speak it.
# DASHSCOPE_TTS_VOICE_ID=
# ALIBABA_KNOWLEDGE_INDEX_ID=
# Public web search for questions the model cannot answer from memory. Not the mall directory.
# ALIBABA_ENABLE_WEB_SEARCH=false
# DASHSCOPE_IMAGE_MODEL=wan2.7-image-pro
# DASHSCOPE_IMAGE_EDIT_MODEL=wan2.7-image-pro
# DASHSCOPE_VIDEO_MODEL=wan3.0-video
# DASHSCOPE_VIDEO_FROM_IMAGE_MODEL=wan3.0-video

# ── TTS (Gemini) ──────────────────────────────────────────────────────────────
# TTS_MODEL=gemini-2.5-flash-tts
# TTS_VOICE_NAME=Achernar
# TTS_VOICE_PROMPT=Read aloud in a warm, welcoming tone with a Singaporean accent. Speak naturally and conversationally.
