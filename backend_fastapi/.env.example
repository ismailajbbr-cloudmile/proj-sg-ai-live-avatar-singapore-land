# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

DATABASE_URL=postgresql+asyncpg://avatar:devpassword@postgres:5432/avatar_chatbot

GOOGLE_VERTEX_PROJECT=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1
VERTEX_AI_WEB_DATASTORE_ID=
VERTEX_AI_PDF_DATASTORE_ID=

# Set by Docker compose environment block — don't override here unless running locally
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-key.json

NEXT_PUBLIC_ORIGIN=http://localhost:3000
