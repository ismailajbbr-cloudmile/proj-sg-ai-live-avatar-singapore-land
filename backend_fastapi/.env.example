# Environment Configuration
APP_ENV=local

# Application Settings
PROJECT_NAME="Avatar Voice Chatbot"
VERSION=1.0.0
DESCRIPTION="Avatar Voice Chatbot with Next.JS as frontend and FastAPI as backend"
DEBUG=true

# API & CORS Configuration
API_V1_STR=/api/v1
ALLOWED_ORIGINS="http://localhost:8000,http://localhost:3000"
FRONTEND_URL=http://localhost:3000
REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
NEXT_PUBLIC_API_URL=http://localhost:8000

# Rate Limiting Configuration
RATE_LIMIT_DEFAULT=200 per day,50 per hour
RATE_LIMIT_LOGIN=20 per minute
RATE_LIMIT_ROOT=10 per minute
RATE_LIMIT_HEALTH=20 per minute

# API Session Middleware 
SESSION_SECRET=
SESSION_MAX_AGE=3600

# Logging Configuration
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_FORMAT=console
TIMEZONE=Asia/Singapore

# Database Configuration
POSTGRES_URL=postgresql://admin%40mile.cloud:Cloudmile123%24@localhost:5432/appdb
POSTGRES_USER=admin@mile.cloud
POSTGRES_PASSWORD=Cloudmile123$
POSTGRES_DB=appdb
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Initial Owner User Configuration
INITIAL_OWNER_EMAIL=admin@mile.cloud
INITIAL_OWNER_PASSWORD=Cloudmile123$
INITIAL_OWNER_NAME=Owner

# Cloud 
# Google Cloud Platform Integration
GCP_REGION=asia-southeast1
GCP_PROJECT_ID=sea-ml-hub
GOOGLE_API_KEY=

# Authentication
# User & Password
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30
SHARE_TOKEN_EXPIRE_DAYS=7
CREDENTIAL_ENCRYPTION_KEY=

# OAuth Setup
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Observability
# Langfuse Configuration
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
